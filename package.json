{
  "name": "laoliu-interview-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "new": "node scripts/new.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "node scripts/serve.mjs",
    "new:paper": "node scripts/new-paper.mjs paper",
    "new:daily": "node scripts/new-paper.mjs daily",
    "new:survey": "node scripts/new-paper.mjs survey",
    "papers:fetch": "python scripts/paper-assets.py",
    "papers:figures": "node scripts/paper-figures.mjs",
    "papers:workbench": "npm run build && PAPER_WORKBENCH=1 node scripts/serve.mjs",
    "papers:clean": "node scripts/paper-cache.mjs --clean",
    "papers:citations": "node scripts/paper-citations.mjs",
    "papers:pdf-figures": "python scripts/paper-pdf-figures.py",
    "papers:quality": "node scripts/paper-quality.mjs",
    "papers:check-live": "node scripts/check-paper-live.mjs"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "markdown-it": "15.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
